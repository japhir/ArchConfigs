# swaymsg -t get_outputs to get overview of outputs
output "LG Display 0x0521 Unknown" {
       mode 1920x1080@60.020Hz
       position 0,0
       scale 1
       alias $MAIN_1
}

profile lap {
	output $MAIN_1 enable
}

profile home {
    # laptop screen goes right on the stand
    output $MAIN_1 enable position 1920,0
    # big screen goes left
    output "LG Electronics W2261 0x0002CF35" mode 1920x1080@60.020Hz position 0,0
}

profile homecinema {
    output $MAIN_1  position 0,0
    # output "Philips Consumer Electronics Company PHL19PFL3405 0x01010101" mode 1920x1080@60.000Hz position 0,-1080
    # output "Samsung Electric Company SAMSUNG 0x01000000" mode 1920x1080@60.000Hz position 0,0 scale 3
    # output "Samsung Electric Company SAMSUNG 0x01000000" mode 1920x1080@60.000Hz position 0,0 scale 1
    output "Samsung Electric Company SAMSUNG 0x01000000" mode 3840x2160@30.00Hz position 0,-1080 scale 2
    # mirror eDP-1 and map it to a full-screen second monitor
    # exec wl-mirror eDP-1
    # exec pkill wlsunset
    # exec swaymsg "for_window [title='Wayland Output Mirror for eDP-1'] move container to workspace $ws10, inhibit_idle fullscreen"
    # exec 'swaymsg for_window [title="Wayland Output Mirror for eDP-1"] move container to workspace $ws10'
}

profile work {
    # main screen goes to the bottom middle
    # output eDP-1 mode 1920x1080@60.020Hz position 2560,360
    # Signe's big screen goes to the top
    # output "HP Inc. HP E273q 6CM9300JV4" mode 2560x1440@59.951Hz position 0,0
    output $MAIN_1 enable
    # monitor in the corner
    output "Acer Technologies Acer V236HL LYWEE0054200" mode 1920x1080@60.000Hz position 0,0
}

profile workhawaii {
    # main screen goes bottom right
    # output eDP-1 mode 1920x1080@60.020Hz position 3841,1000 scale 1
    output $MAIN_1 enable
    # big screen goes left
    # output "LG Electronics LG HDR WQHD+ 209NTTQGN817" mode 3840x1600@74.977Hz position 0,0 scale 1
    output "LG Electronics *" mode 3840x1600@74.977Hz position 0,0 scale 1
}

profile schuberg {
	output $MAIN_1 enable position 1280,1440
	output "Dell Inc. DELL P3223DE BHS95H3" mode 2560x1440@59.95Hz position 0,0 scale 1
}