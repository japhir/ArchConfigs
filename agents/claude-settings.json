{
  "model": "opus",
  "permissions": {
    "deny": ["AskUserQuestion"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-dangerous-git.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-redundant-cd.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-uv-run.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-type-ignore.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-subagent-model.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-org-reads.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": false
}
