{
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git restore --staged *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git remote *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ty check *)",
      "Bash(uv add *)",
      "Bash(awk *)",
      "Bash(pdftotext *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh repo *)",
      "Bash(export PAGER=cat)",
      "WebSearch",
      "Read(~/.claude/**)",
      "Read(~/.agents/skills/**)",
      "Bash(psql *)",
      "Bash(docker info *)",
      "Read(//private/tmp/**)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Edit(~/org/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-dangerous-git.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-redundant-cd.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-uv-run.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-gh-view-body.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-kill-by-port.sh\""
          }
        ]
      },
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-org-reads.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-type-ignore.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/require-subagent-model.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/org-conventions.sh\""
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/statusline.sh\""
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": false,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": false,
  "fileCheckpointingEnabled": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv run tools/yt_transcript.py:*) in ~/Documents/LLM-wiki — sanctioned transcript capture into raw/videos/, the documented way content lands in raw/"
    ],
    "environment": [
      "$defaults",
      "**Organization**: fwdfaster.ai — a future with expert-powered AI",
      "**Primary use of Claude Code**: senior AI research engineer",
      "**Source control**: local git repositories, most often with a private GitHub remote under github.com/fwdfaster/ — that org and all repos under it are trusted push destinations",
      "**Repository visibility**: all github.com/fwdfaster repos are private for now; assume private unless a repo is explicitly stated to be public",
      "**Trusted internal domains**: *.fwdfaster.ai — currently screenathon.fwdfaster.ai, with more subdomains to follow",
      "**Secrets management**: real secrets live in local .env files that are never committed; git-tracked .env.example files hold placeholder values only and are safe to read, edit, and commit",
      "**Org-specific CLIs**: none proprietary — uv (Python runner), gh, psql, and graphify are the non-standard CLIs in regular use"
    ]
  }
}
