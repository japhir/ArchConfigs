// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="kitty"
    opacity 0.90
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="org.quickshell$"
    open-floating true
}

// @id=wr_1772032505879910010 @name=emacs
window-rule {
    match app-id="^emacs$"
    open-maximized-to-edges true
}

// @id=wr_1772034779309332181 @name=firefox
window-rule {
    match app-id="^firefox$"
    open-maximized-to-edges true
}

// @id=wr_1772035799850145926 @name=thunar
window-rule {
    match app-id="^thunar$" title="^Rename"
    open-floating true
}

// @id=wr_1781762847946988341 @name=Tygron Client LTS
window-rule {
    match app-id="Tygron Client LTS"
    open-floating true
}

// @id=wr_1781762951546977694 @name=Rule
window-rule {
    match title="PreloaderApp"
    open-floating true
}
