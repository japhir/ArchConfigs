#!/bin/bash

PI_DIR="${HOME}/.pi/agent"
SKILLS_DIR="${HOME}/.agents/skills"

mkdir -p "$PI_DIR"
mkdir -p "$SKILLS_DIR"

# 1. parse security override flag
ARGS=()
TINKER_MODE=false
for arg in "$@"; do
    if [ "$arg" = "--tinker" ]; then
        TINKER_MODE=true
    else
        ARGS+=("$arg")
    fi
done

# 2. trace script back to real home to find git root
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -h "$TARGET_FILE" ]; do
    TARGET_FILE=$(readlink "$TARGET_FILE")
done
SCRIPT_REAL_DIR=$(cd "$(dirname "$TARGET_FILE")" && pwd)
SCRIPT_GIT_ROOT=$(cd "$SCRIPT_REAL_DIR" && git rev-parse --show-toplevel 2>/dev/null)
CURRENT_GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

# 3. determine workspace mode
WORKSPACE_MODE="rw"
if [ -n "$SCRIPT_GIT_ROOT" ] && [ "$SCRIPT_GIT_ROOT" = "$CURRENT_GIT_ROOT" ]; then
    if [ "$TINKER_MODE" = true ]; then
        echo "🔓 TINKER MODE ACTIVE: Host write protection bypassed by user request."
        WORKSPACE_MODE="rw"
    else
	echo "⚠️  Security Warning: Launching from inside the configuration Git repository."
	echo "   Forcing Read-Only (:ro) workspace to protect scripts and dotfiles."
	WORKSPACE_MODE="ro"
    fi
fi

# run docker using the filtered ${ARGS[@]} array instead of $@
docker run -it --rm \
  --user "$(id -u):$(id -g)" \
  --network bridge \
  --cap-drop=ALL \
  --security-opt no-new-privileges:true \
  -v "${PWD}":"/workspace":${WORKSPACE_MODE} \
  -v "${PI_DIR}":"/home/sandbox/.pi/agent":rw \
  -v "${SKILLS_DIR}":"/home/sandbox/.agents/skills":ro \
  -e OLLAMA_HOST="host.docker.internal:11434" \
  -e ANTHROPIC_API_KEY \
  -e OPENAI_API_KEY \
  -e UV_PROJECT_ENVIRONMENT="/workspace/.venv-docker" \
  local/pi-sandbox "${ARGS[@]}"
